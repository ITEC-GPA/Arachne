<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><TargetFramework>net48</TargetFramework><OutputType>Exe</OutputType><PlatformTarget>x64</PlatformTarget></PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Arachne.Arap\Arachne.Arap.csproj" />
    <Reference Include="GPCGeometry"><HintPath>$(GpcGeometryPath)</HintPath></Reference>
    <Reference Include="GPCUtilities"><HintPath>$(GpcUtilitiesPath)</HintPath></Reference>
    <!-- Optional reference implementation, used only by native comparisons. -->
    <Content Include="$(NativeIglPath)" Condition="Exists('$(NativeIglPath)')"><Link>Arachne.IGL.dll</Link><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
  </ItemGroup>
</Project>
