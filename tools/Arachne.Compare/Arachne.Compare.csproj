<Project Sdk="Microsoft.NET.Sdk">
  <!-- Plug-in independent comparison of form-finding results: builds the same Grasshopper definitions through the
       component GUIDs and ports only, so the same tool runs on Arachne master and on the GPC migration. It references
       no Arachne assembly: the plug-in under test is loaded from the folder given on the command line. On .NET 8 it also
       loads the net48 builds of earlier versions. -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <OutputType>Exe</OutputType>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Grasshopper"><HintPath>$(GrasshopperDir)\Grasshopper.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="GH_IO"><HintPath>$(GrasshopperDir)\GH_IO.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="RhinoCommon"><HintPath>$(RhinoSystemDir)\RhinoCommon.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
