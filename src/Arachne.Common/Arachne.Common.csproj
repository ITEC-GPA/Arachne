<Project Sdk="Microsoft.NET.Sdk">
  <!-- Model and helpers ported from FeMM.Common: FEM model, form-finding assembly for TensileLib. -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <TensileLibDirectory>$([System.IO.Path]::GetDirectoryName('$(TensileLibPath)'))</TensileLibDirectory>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="RhinoCommon"><HintPath>$(RhinoSystemDir)\RhinoCommon.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="GPCGeometry"><HintPath>$(GpcGeometryPath)</HintPath><Private>true</Private></Reference>
    <Reference Include="GPCUtilities"><HintPath>$(GpcUtilitiesPath)</HintPath><Private>true</Private></Reference>
    <Reference Include="TensileLib"><HintPath>$(TensileLibPath)</HintPath><Private>true</Private></Reference>
    <Reference Include="alglibnet2"><HintPath>$(TensileLibDirectory)\alglibnet2.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="System.Drawing" />
    <PackageReference Include="MathNet.Numerics" Version="5.0.0" />
  </ItemGroup>
  <Target Name="CheckLocalLibraries" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(GpcGeometryPath)')" Text="GPCGeometry.dll mancante. Impostare GpcGeometryPath." />
    <Error Condition="!Exists('$(GpcUtilitiesPath)')" Text="GPCUtilities.dll mancante. Impostare GpcUtilitiesPath." />
    <Error Condition="!Exists('$(TensileLibPath)')" Text="TensileLib.dll mancante. Compilare ../tensilelib in Release o impostare TensileLibPath." />
    <Error Condition="!Exists('$(TensileLibDirectory)\alglibnet2.dll')" Text="alglibnet2.dll mancante accanto a TensileLib.dll." />
    <Error Condition="!Exists('$(RhinoSystemDir)\RhinoCommon.dll')" Text="RhinoCommon.dll non trovata: impostare RhinoSystemDir." />
  </Target>
</Project>
