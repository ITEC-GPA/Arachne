<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <DefineConstants Condition="Exists('$(TensileLibPath)')">$(DefineConstants);TENSILELIB</DefineConstants>
    <TensileLibDirectory>$([System.IO.Path]::GetDirectoryName('$(TensileLibPath)'))</TensileLibDirectory>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="GPCGeometry"><HintPath>$(GpcGeometryPath)</HintPath><Private>true</Private></Reference>
    <Reference Include="GPCUtilities"><HintPath>$(GpcUtilitiesPath)</HintPath><Private>true</Private></Reference>
    <Reference Include="TensileLib" Condition="Exists('$(TensileLibPath)')"><HintPath>$(TensileLibPath)</HintPath><Private>true</Private></Reference>
    <Reference Include="alglibnet2" Condition="Exists('$(TensileLibPath)')"><HintPath>$(TensileLibDirectory)\alglibnet2.dll</HintPath><Private>true</Private></Reference>
    <PackageReference Include="MathNet.Numerics" Version="5.0.0" />
    <PackageReference Include="System.Drawing.Common" Version="4.7.3" />
  </ItemGroup>
  <Target Name="CheckLocalLibraries" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(GpcGeometryPath)')" Text="GPCGeometry.dll mancante. Impostare GpcGeometryPath." />
    <Error Condition="!Exists('$(GpcUtilitiesPath)')" Text="GPCUtilities.dll mancante. Impostare GpcUtilitiesPath." />
    <Error Condition="Exists('$(TensileLibPath)') and !Exists('$(TensileLibDirectory)\alglibnet2.dll')" Text="alglibnet2.dll mancante accanto a TensileLib.dll." />
    <Message Condition="!Exists('$(TensileLibPath)')" Importance="high" Text="Arachne: compilazione senza motore TensileLib. Modellazione disponibile; Form Find restituisce DependencyMissing." />
  </Target>
</Project>
